<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sinloingok.app.dao.MemberDao">
    <resultMap id="BaseResultMap" type="com.sinloingok.app.models.user.User">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="open_id" property="openId" jdbcType="VARCHAR"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="mobile" property="mobile" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="random_code" property="randomCode" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
        <result column="nickname" property="nickname" jdbcType="VARCHAR"/>
        <result column="money" property="money" jdbcType="FLOAT"/>
        <result column="ext_money" property="extMoney" jdbcType="FLOAT"/>
        <result column="role_id" property="roleId" jdbcType="BIGINT"/>
        <result column="level" property="level" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="last_login_ip" property="lastLoginIp" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="VARCHAR"/>
        <result column="last_login_time" property="lastLoginTime" jdbcType="VARCHAR"/>
        <result column="balance" property="balance" jdbcType="FLOAT"/>
        <result column="new_recharge_time" property="newRechargeTime" jdbcType="VARCHAR"/>
        <result column="dev_id" property="devId" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, open_id, username, mobile, password, random_code,
        avatar, nickname, money, ext_money, role_id,
        level, status, last_login_ip, create_time, last_login_time,
        balance, new_recharge_time, dev_id
    </sql>

    <select id="selectMemberList" resultMap="BaseResultMap">
        SELECT us.id, us.nickname, us.status, us.create_time,
        us.avatar, us.balance, us.mobile,
        IFNULL(us.money,0) AS money, IFNULL(us.ext_money,0) AS ext_money
        FROM user us
        WHERE 1=1
        <if test="memberName != null and memberName != ''">
            AND us.mobile LIKE CONCAT('%', #{memberName}, '%')
        </if>
        <if test="mobile != null and mobile != ''">
            AND us.mobile LIKE CONCAT('%', #{mobile}, '%')
        </if>
        <if test="userStatus != null and userStatus != ''">
            AND us.status = #{userStatus}
        </if>
        ORDER BY us.new_recharge_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countMemberList" resultType="long">
        SELECT COUNT(*)
        FROM user us
        WHERE 1=1
        <if test="memberName != null and memberName != ''">
            AND us.mobile LIKE CONCAT('%', #{memberName}, '%')
        </if>
        <if test="mobile != null and mobile != ''">
            AND us.mobile LIKE CONCAT('%', #{mobile}, '%')
        </if>
        <if test="userStatus != null and userStatus != ''">
            AND us.status = #{userStatus}
        </if>
    </select>

    <resultMap id="FeedbackMap" type="com.sinloingok.app.models.user.Feedback">
        <id column="id" property="id"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
        <result column="title" property="title"/>
        <result column="mobile" property="mobile"/>
        <result column="nickname" property="nickname"/>
    </resultMap>

    <select id="selectFeedbackList" resultMap="FeedbackMap">
        SELECT f.id, f.content, f.create_time, f.title, f.mobile, u.nickname
        FROM feedback f
        LEFT JOIN user u ON f.user_id = u.id
        WHERE 1=1
        <if test="searchNickname != null and searchNickname != ''">
            AND u.nickname LIKE CONCAT('%', #{searchNickname}, '%')
        </if>
        <if test="searchMobile != null and searchMobile != ''">
            AND u.mobile LIKE CONCAT('%', #{searchMobile}, '%')
        </if>
        <if test="searchContent != null and searchContent != ''">
            AND f.content LIKE CONCAT('%', #{searchContent}, '%')
        </if>
        <if test="begin != null and begin != ''">
            AND f.create_time &gt;= #{begin}
        </if>
        <if test="end != null and end != ''">
            AND f.create_time &lt;= #{end}
        </if>
        ORDER BY f.create_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countFeedbackList" resultType="long">
        SELECT COUNT(*)
        FROM feedback f
        LEFT JOIN user u ON f.user_id = u.id
        WHERE 1=1
        <if test="searchNickname != null and searchNickname != ''">
            AND u.nickname LIKE CONCAT('%', #{searchNickname}, '%')
        </if>
        <if test="searchMobile != null and searchMobile != ''">
            AND u.mobile LIKE CONCAT('%', #{searchMobile}, '%')
        </if>
        <if test="searchContent != null and searchContent != ''">
            AND f.content LIKE CONCAT('%', #{searchContent}, '%')
        </if>
        <if test="begin != null and begin != ''">
            AND f.create_time &gt;= #{begin}
        </if>
        <if test="end != null and end != ''">
            AND f.create_time &lt;= #{end}
        </if>
    </select>
</mapper>